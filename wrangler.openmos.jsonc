{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "openmos",
  "main": "src/index.ts",
  // 2026-10-30 is the newest date this Wrangler's workerd accepts.
  "compatibility_date": "2026-10-30",
  "workers_dev": true,
  // Custom domain mos.1791147.xyz (zone is in this account; picked by
  // the owner 2026-11-10 as the OpenMos entry while mos.oonn.pp.ua's
  // zone lives in another account and hivemos stays suspended).
  "routes": [{ "pattern": "mos.1791147.xyz", "custom_domain": true }],
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "html_handling": "auto-trailing-slash",
    "not_found_handling": "404-page",
    "run_worker_first": ["/*"]
  },
  "ai": {
    "binding": "AI"
  },
  // Same Vectorize index and D1 database as the hivemos worker: both
  // scripts serve the same data; only the script name differs.
  "vectorize": [{ "binding": "MEMORY_VECTORS", "index_name": "hivemos-memories" }],
  // No cron triggers for now: this account is at the Workers Free limit
  // of 5 cron triggers, and a failed trigger update fails the whole
  // deploy step. Add the hourly trigger back once a slot frees up.
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "hivemos",
      "database_id": "6c07d734-ca39-41ea-ba81-2a392e4abdf2",
      "migrations_dir": "migrations"
    }
  ]
}
