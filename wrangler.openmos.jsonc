{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "openmos",
  "main": "src/index.ts",
  // 2026-10-30 is the newest date this Wrangler's workerd accepts.
  "compatibility_date": "2026-10-30",
  "workers_dev": true,
  // Custom domain mos.oonn.pp.ua is PENDING: its zone is on Cloudflare
  // but not visible from this account's deploy token (wrangler error
  // 10082 "Can't infer zone from route", 2026-11-10), so the route is
  // intentionally not declared yet. Adding it back is a one-line change
  // once the zone/account question is resolved.
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "html_handling": "auto-trailing-slash",
    "not_found_handling": "404-page",
    "run_worker_first": ["/*"]
  },
  "ai": {
    "binding": "AI"
  },
  // Same Vectorize index and D1 database as the hivemos worker: both
  // scripts serve the same data; only the script name differs.
  "vectorize": [{ "binding": "MEMORY_VECTORS", "index_name": "hivemos-memories" }],
  "triggers": {
    "crons": ["0 * * * *"]
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "hivemos",
      "database_id": "6c07d734-ca39-41ea-ba81-2a392e4abdf2",
      "migrations_dir": "migrations"
    }
  ]
}
