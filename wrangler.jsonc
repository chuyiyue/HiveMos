{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "hivemos",
  "main": "src/index.ts",
  // 2026-10-30 is the newest date this Wrangler's workerd accepts.
  "compatibility_date": "2026-10-30",
  "workers_dev": true,
  "routes": [{ "pattern": "mos.loko.pp.ua", "custom_domain": true }],
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "html_handling": "auto-trailing-slash",
    "not_found_handling": "404-page",
    "run_worker_first": ["/*"]
  },
  "ai": {
    "binding": "AI"
  },
  "triggers": {
    "crons": ["0 */6 * * *"]
  },
  // database_id 可留空：当前 Wrangler 的配置校验不强制填写。
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "hivemos",
      // 部署前用 wrangler d1 create hivemos 回填
      "database_id": "6c07d734-ca39-41ea-ba81-2a392e4abdf2",
      "migrations_dir": "migrations"
    }
  ]
}
